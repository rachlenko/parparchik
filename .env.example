PARPARCHIK_PUBLIC_BUCKET=public-bucket
PARPARCHIK_PRIVATE_BUCKET=private-bucket
AWS_REGION=us-east-1
PARPARCHIK_HOST=0.0.0.0
PARPARCHIK_PORT=8080

# For MinIO / custom S3 endpoint (leave empty for real AWS)
S3_ENDPOINT=localhost:9000

# AWS credentials (or use IAM role / ~/.aws/credentials)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
